# Generate the key and password as described in README.md. Never commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=mehr_uebrig
POSTGRES_USER=mehr_uebrig
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# Set to 1 only behind a trusted proxy that overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY=0
# Optional PostgreSQL connection URL (takes precedence over POSTGRES_* host fields).
DATABASE_URL=
# Production password reset requires a working mail provider and verified sender.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=
